# Default policy: free, once per account/event, per-number shipping/point prizes.
# Client build-time flag (.env.local); keep OFF until release approval.
NEXT_PUBLIC_NERAIUCHI_ENABLED=false
# Functions runtime flag (functions/.env); keep OFF until release approval.
NERAIUCHI_ENABLED=false
# Local testing only. Uses demo-yumetsuki and loopback emulators, never production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
