rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function serverOnly(collection) {
      return collection in [
        'admins', 'users', 'xAccountClaims', 'usedCodes', 'userGachaHistory',
        'gachaShippingClaims', 'rewardRedemptions',
        'nibuichi_user_predictions', 'nibuichi_daily', 'nibuichi_global',
        'quizzes_archive', 'neraiuchiEvents', 'neraiuchiEventsArchive',
        'neraiuchiSecrets', 'neraiuchiCounters', 'neraiuchiUserHistory', 'neraiuchiAudit',
        'nanikaGachaSlots', 'nanikaGachaRounds', 'nanikaGachaArchives',
        'nanikaGachaImages', 'nanikaGachaImageData', 'nanikaGachaInventory',
        'nanikaGachaReceipts', 'nanikaGachaPending', 'nanikaGachaHistory', 'nanikaGachaAudit'
      ];
    }
    // Keep legacy public reads; financial/eligibility writes require an admin or server.
    match /{collection}/{document=**} {
      allow read: if !(collection in [
        'quizzes', 'neraiuchiEvents', 'neraiuchiEventsArchive', 'neraiuchiSecrets',
        'neraiuchiCounters', 'neraiuchiUserHistory', 'neraiuchiAudit',
        'xAccountClaims', 'validCodes', 'usedCodes', 'gachaShippingClaims', 'rewardRedemptions',
        'nanikaGachaSlots', 'nanikaGachaRounds', 'nanikaGachaArchives',
        'nanikaGachaImages', 'nanikaGachaImageData', 'nanikaGachaInventory',
        'nanikaGachaReceipts', 'nanikaGachaPending', 'nanikaGachaHistory', 'nanikaGachaAudit'
      ]);
      allow write: if !serverOnly(collection) && collection != 'quizzes' && isAdmin();
    }
    match /admins/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /validCodes/{document=**} {
      allow read: if isAdmin();
    }
    match /usedCodes/{document=**} {
      allow read: if isAdmin();
    }
    match /users/{uid} {
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['xAccount'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['points'])
          || (request.resource.data.points is int && request.resource.data.points >= 0
            && request.resource.data.points <= 9007199254740991));
      match /orica/{id} {
        allow create, update: if isAdmin() || ((request.auth != null && request.auth.uid == uid)
          && request.resource.data.keys().hasOnly(['owned', 'updatedAt'])
          && request.resource.data.owned is bool
          && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp));
        allow delete: if isAdmin();
      }
    }
    match /quizzes/{quizId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /answers/{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
